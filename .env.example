# Copy to .env and adjust. Never commit the real .env.

# Required in production; a dev fallback key is used when unset.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Set to 0 in production. Disables DEBUG and enables the secure flags
# (HSTS, SSL redirect, secure cookies) configured in config/settings.py.
DJANGO_DEBUG=1

# Comma-separated list of allowed hosts.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Default region for phone-number parsing (ISO 3166-1 alpha-2).
# Numbers entered without a country code are interpreted in this region.
DEFAULT_PHONE_REGION=US

# --- Email delivery ----------------------------------------------------------
# Leave EMAIL_BACKEND unset in development to print emails in the server log.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=no-reply@example.com

# --- Production database ----------------------------------------------------
# Railway PostgreSQL provides this value automatically when linked to the app.
# DATABASE_URL=

# --- Production realtime layer ---------------------------------------------
# Railway Redis provides this value when linked to the app.
# CHANNEL_REDIS_URL=redis://127.0.0.1:6379/1
