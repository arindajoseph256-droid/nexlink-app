{
  "expo": {
    "name": "Nexlink",
    "slug": "nexlink-mobile",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#071d22",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#071d22",
      "imageWidth": 180
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nexlink.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Nexlink uses the camera to take photos you send in chats.",
        "NSMicrophoneUsageDescription": "Nexlink uses the microphone to record voice messages.",
        "NSPhotoLibraryUsageDescription": "Nexlink needs photo access so you can send pictures."
      }
    },
    "android": {
      "package": "com.nexlink.mobile",
      "versionCode": 2,
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#071d22",
        "imageWidth": 180
      },
      "adaptiveIcon": {
        "backgroundColor": "#071d22",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "permissions": [
        "INTERNET",
        "POST_NOTIFICATIONS",
        "CAMERA",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/00000000-0000-0000-0000-000000000000",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "on-load"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
